# Environment for server.js (read from the process environment; in production
# these go in the `website` service of ~/app/compose.yaml, not in a file the
# app loads itself -- server.js has no dotenv dependency on purpose).

HOST=127.0.0.1
PORT=4173

# Owner-only waitlist viewer at /admin/waitlist (404 unless both are set).
WAITLIST_ADMIN_USERNAME=
WAITLIST_ADMIN_PASSWORD=

# ---- /links page (the exhibition QR code points at https://baraqapp.com/links)
# Each button appears only when its value is set. URLs must be https://;
# anything else is ignored and logged at startup. The startup log also prints
# which buttons are active, e.g. "/links buttons: app, website, instagram, ...".
BARAQ_LINK_FACEBOOK_URL=
BARAQ_LINK_INSTAGRAM_URL=
BARAQ_LINK_TELEGRAM_URL=
# Leave empty until the LinkedIn page exists -- the button stays hidden.
BARAQ_LINK_LINKEDIN_URL=
# A plain address; the page turns it into a mailto: link.
BARAQ_LINK_EMAIL=

# These two default to the values below when unset.
BARAQ_LINK_WEBSITE_URL=https://baraqapp.com
BARAQ_LINK_WEB_APP_URL=https://web.baraqapp.com
